{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm run build"
  },
  "deploy": {
    "startCommand": "npx serve apps/web/dist -l tcp://0.0.0.0:$PORT --single",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
